{
  "name": "notewordy",
  "description": "NoteWordy is a modern minimilistic note app with word and page count.",
  "type": "module",
  "private": true,
  "main": "dist-electron/main.js",
  "author": "Tekibo",
  "version": "0.0.1",
  "license": "MIT",
  "scripts": {
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "transpile:electron": "tsc --project electron/tsconfig.json",
    "watch:electron": "tsc --watch --project electron/tsconfig.json",
    "dev:electron": "pnpm transpile:electron && concurrently -k \"pnpm watch:electron\" \"cross-env NODE_ENV=development pnpm dlx electronmon .\"",
    "dev:nuxt": "nuxt dev",
    "dist:mac": "pnpm build && pnpm transpile:electron && electron-builder --mac --arm64",
    "dist:win": "pnpm build && pnpm transpile:electron && electron-builder --win --x64",
    "dist:linux": "pnpm build && pnpm transpile:electron && electron-builder --linux --x64",
    "dev": "concurrently -k -s first -n \"NUXT,ELECTRON\" -c \"blue,green\" \"pnpm dev:nuxt\" \"wait-on http://localhost:3000 && pnpm dev:electron\""
  },
  "dependencies": {
    "@number-flow/vue": "^0.5.0",
    "@nuxt/image": "2.0.0",
    "@vueuse/core": "^14.2.1",
    "@vueuse/nuxt": "14.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-vue-next": "^0.577.0",
    "nuxt": "^4.4.2",
    "reka-ui": "^2.9.2",
    "shadcn-nuxt": "2.4.3",
    "tailwind-merge": "^3.5.0",
    "vue": "^3.5.30",
    "vue-router": "^5.0.3"
  },
  "packageManager": "pnpm@10.32.1+sha512.a706938f0e89ac1456b6563eab4edf1d1faf3368d1191fc5c59790e96dc918e4456ab2e67d613de1043d2e8c81f87303e6b40d4ffeca9df15ef1ad567348f2be",
  "devDependencies": {
    "@iconify-json/radix-icons": "^1.2.6",
    "@iconify/vue": "^5.0.0",
    "@nuxtjs/color-mode": "^4.0.0",
    "@tailwindcss/vite": "^4.2.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^41.0.2",
    "electron-builder": "^26.8.1",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "wait-on": "^9.0.4"
  }
}