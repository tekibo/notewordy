{
  "name": "notewordy",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -s first -n \"NUXT,ELECTROBUN\" -c \"blue,green\" \"pnpm --filter @notewordy/web dev\" \"wait-on http://localhost:3000 && pnpm --filter @notewordy/desktop dev\"",
    "build:web": "pnpm --filter @notewordy/web generate",
    "build": "pnpm build:web && pnpm --filter @notewordy/desktop build",
    "build:dev": "pnpm build:web && pnpm --filter @notewordy/desktop build:dev",
    "dist:linux": "pnpm build:web && pnpm --filter @notewordy/desktop build",
    "dist:mac": "pnpm build:web && pnpm --filter @notewordy/desktop build",
    "dist:win": "pnpm build:web && pnpm --filter @notewordy/desktop build"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "wait-on": "^9.0.4"
  }
}
