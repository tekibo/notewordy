{
  "extends": "./.hutch/devkit/tsconfig.json",
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["@types/bun"]
  },
  "include": [
    "src",
    "electrobun.config.ts",
    "hutch.config.ts"
  ],
  "exclude": ["node_modules", "dist", "build", "dist-web"]
}