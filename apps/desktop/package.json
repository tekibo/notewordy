{
  "name": "@notewordy/desktop",
  "type": "module",
  "private": true,
  "main": "dist-electron/main.js",
  "version": "0.0.1",
  "license": "MIT",
  "scripts": {
    "transpile": "tsc --project tsconfig.json",
    "watch": "tsc --watch --project tsconfig.json",
    "dev": "pnpm transpile && concurrently -k \"pnpm watch\" \"cross-env NODE_ENV=development pnpm dlx electronmon .\"",
    "dist:mac": "pnpm transpile && electron-builder --mac --arm64",
    "dist:win": "pnpm transpile && electron-builder --win --x64",
    "dist:linux": "pnpm transpile && electron-builder --linux --x64"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^41.0.2",
    "electron-builder": "^26.8.1",
    "typescript": "^5.9.3"
  }
}
