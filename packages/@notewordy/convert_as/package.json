{
  "name": "@notewordy/convert_as",
  "version": "1.0.0",
  "description": "Assamese text converter between Geetanjali (legacy font) and Unicode",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "tsc",
    "build:bundle": "ncc build src/index.ts -o dist -m",
    "dev": "tsx src/index.ts",
    "extract": "node gen.mjs",
    "typecheck": "tsc --noEmit"
  },
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@vercel/ncc": "^0.38.4",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  },
  "keywords": [
    "assamese",
    "geetanjali",
    "unicode",
    "converter",
    "font"
  ],
  "author": "TEKIBO",
  "files": [
    "dist"
  ]
}